#!/bin/sh
# DeterminAgents shim — wraps git operations and host-tool installation
set -eu

# Subcommand list lives in three places that must stay in sync: the `help`
# heredoc, the `doctor`/`completions` outputs, and the bash/zsh/fish
# completion bodies. The completion scripts run in a separate shell after
# being eval'd, so a runtime variable wouldn't reach them — duplication is
# the honest shape here.

# This line is replaced by the installer. Do not edit manually.
DETERMINAGENTS_BAKED_HOME=""

# Resolve DETERMINAGENTS_HOME:
# 1. Environment variable (manual override)
# 2. Baked path (set during last install — ensures we remember the user's choice)
# 3. Relative to script (if run from a clone — priority for developers)
# 4. Default path
if [ -n "${DETERMINAGENTS_HOME:-}" ]; then
  RESOLVED_VIA="env"
elif [ -n "$DETERMINAGENTS_BAKED_HOME" ]; then
  DETERMINAGENTS_HOME="$DETERMINAGENTS_BAKED_HOME"
  RESOLVED_VIA="baked"
elif [ -f "$(dirname "$0")/../INVOCATIONS.md" ] && { [ -d "$(dirname "$0")/../.git" ] || [ -d "$(dirname "$0")/../.sisyphus" ]; }; then
  DETERMINAGENTS_HOME=$(cd "$(dirname "$0")/.." && pwd)
  RESOLVED_VIA="relative"
else
  DETERMINAGENTS_HOME="$HOME/.determinagents"
  RESOLVED_VIA="default"
fi

# --- Prompt-library helpers (shared by `prompt`, `setup`, `doctor`) ---
# _det_invoc resolves to the local INVOCATIONS.md, or to a fetched copy
# when DETERMINAGENTS_INVOC_FILE is set (`prompt --remote`).
_det_invoc() { printf '%s' "${DETERMINAGENTS_INVOC_FILE:-$DETERMINAGENTS_HOME/INVOCATIONS.md}"; }
# Every routable token, live from the routing table, plus anchor-only
# sections (e.g. 'maintenance') that have no routing row.
_det_tokens() {
  {
    awk -F'|' '/^\| `/ {
      line=$2
      while (match(line, /`[a-z][a-z-]*`/)) {
        print substr(line, RSTART+1, RLENGTH-2)
        line=substr(line, RSTART+RLENGTH)
      }
    }' "$(_det_invoc)"
    # Real anchors only (token charset [a-z,-]); the authoring example
    # in INVOCATIONS.md uses <token> placeholders and must not parse.
    grep -E '^<!-- prompt:[a-z,-]+ -->$' "$(_det_invoc)" \
      | sed -e 's/^<!-- prompt://' -e 's/ -->$//' -e 's/,/^/g' \
      | tr '^' '\n'
  } | awk '!seen[$0]++'
}
# Routing table's doc for a token (empty for anchor-only sections).
_det_doc() {
  awk -F'|' -v t="$1" '
    /^\| `/ {
      if (match($2, "`" t "`")) {
        s=$3; sub(/^[^`]*`/, "", s); sub(/`.*/, "", s); print s; exit
      }
    }' "$(_det_invoc)"
}
# Section owned by an anchor: the anchor's own heading first, then
# through the next anchor or level-2 heading; trailing separators
# and blank lines trimmed.
_det_section() {
  awk -v start="$1" '
    NR <= start { next }
    !armed { buf[++n]=$0; armed=1; next }
    /^<!-- prompt:[a-z,-]+ -->$/ || /^## / { exit }
    { buf[++n]=$0 }
    END {
      while (n>0 && (buf[n]=="" || buf[n]=="---")) n--
      for (i=1; i<=n; i++) print buf[i]
    }' "$(_det_invoc)"
}
_det_anchor_line() {
  grep -n -E "^<!-- prompt:([a-z,-]*,)?$1(,| -->)" "$(_det_invoc)" | head -1 | cut -d: -f1
}
# "token|menu description" per routing row, live from the table.
_det_routing() {
  awk -F'|' '/^\| `/ {
    line=$2
    c3=$3; gsub(/`/, "", c3); gsub(/"/, "", c3)
    sub(/^ +/, "", c3); sub(/ +$/, "", c3)
    while (match(line, /`[a-z][a-z-]*`/)) {
      tok=substr(line, RSTART+1, RLENGTH-2)
      line=substr(line, RSTART+RLENGTH)
      if (c3 != "") print tok "|" c3
      else print tok "|DeterminAgents " tok
    }
  }' "$(_det_invoc)"
}

if [ ! -d "$DETERMINAGENTS_HOME/audits" ]; then
  # `prompt --remote` is the one command that needs no local library —
  # it resolves everything over HTTPS. Let it through; everything else
  # still requires a checkout.
  _needs_local=1
  if [ "${1:-}" = "prompt" ]; then
    for _aa in "$@"; do
      if [ "$_aa" = "--remote" ]; then _needs_local=0; break; fi
    done
  fi
  if [ "$_needs_local" -eq 1 ]; then
    echo "error: determinagents library not found at $DETERMINAGENTS_HOME" >&2
    echo "  (resolved via $RESOLVED_VIA)" >&2
    [ -n "$DETERMINAGENTS_BAKED_HOME" ] && [ "$DETERMINAGENTS_HOME" != "$DETERMINAGENTS_BAKED_HOME" ] && echo "  (baked path was: $DETERMINAGENTS_BAKED_HOME)" >&2
    echo "" >&2
    echo "  run the installer to fix your paths:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/iansherr/determinagents/main/install.sh | sh" >&2
    echo "  (or use 'prompt --remote' for a library-less HTTPS resolve)" >&2
    exit 1
  fi
fi

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in

  version|--version|-v)
    cd "$DETERMINAGENTS_HOME"
    SHA=$(git rev-parse --short HEAD)
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    DATE=$(git log -1 --format=%cd --date=short)
    SUBJECT=$(git log -1 --format=%s)
    echo "determinagents $SHA  ($BRANCH, $DATE)"
    echo "  $SUBJECT"
    echo "  library: $DETERMINAGENTS_HOME ($RESOLVED_VIA)"
    ;;

  path)
    echo "$DETERMINAGENTS_HOME"
    ;;

  update)
    cd "$DETERMINAGENTS_HOME"
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    OLD_SHA=$(git rev-parse HEAD)
    echo "fetching origin/$BRANCH..."
    git fetch --quiet origin "$BRANCH"
    NEW_SHA=$(git rev-parse "origin/$BRANCH")

    if [ "$OLD_SHA" = "$NEW_SHA" ]; then
      echo "already up to date ($(git rev-parse --short HEAD))"
      exit 0
    fi

    echo ""
    echo "Changes since current ($(git rev-parse --short HEAD)):"
    echo "---"
    git log --oneline "$OLD_SHA..$NEW_SHA"
    echo "---"
    echo ""
    git diff --stat "$OLD_SHA..$NEW_SHA"
    echo ""

    printf "Apply update? [y/N] "
    read -r REPLY
    case "$REPLY" in
      y|Y|yes|YES)
        git pull --ff-only --quiet origin "$BRANCH"
        echo "updated to $(git rev-parse --short HEAD)"
        echo ""
        echo "if you previously ran 'determinagents materialize', re-run it"
        echo "to regenerate any changed slash commands."
        ;;
      *)
        echo "skipped"
        ;;
    esac
    ;;

  materialize|install-commands)
    cat <<MSG
To complete materialization, hand this prompt to a coding agent in your tool
(Claude Code, Gemini, Cursor, etc.):

---
Read ${DETERMINAGENTS_HOME}/INSTALL.md and install the DeterminAgents
library for this host tool.

Identify the host tool from context, pick the appropriate target convention,
and generate the install files. Start by creating the primary
\`/determinagents\` command and use it as both hub and router.

**Discovery & Autocomplete Strategy:**
- **AGY CLI**: Generate subagent configurations in \`.agy/subagents/\` or \`~/.agy/subagents/\`.
- **Claude Code & opencode**: Create a single \`/determinagents\` command that acts as a hub and router, using arguments for direct routing (e.g. \`/determinagents resolve\`). Use \`argument-hint\` for discovery.
- **Gemini CLI (Legacy)**: Use **subdirectory namespacing** (\`/determinagents:<name>\`) because it doesn't support argument autocomplete. Support remains until June 2026.
- **Cursor**: Use agent-requested MDC rules.

If DeterminAgents commands already exist in the host tool, treat this as a
re-materialize. Compare the existing files against the new library path and
the latest \`INVOCATIONS.md\`.

- If a file lacks the \`generated-by\` marker or points to a different
  library path: treat it as a 'legacy' or 'hand-edited' file and PROMPT
  ME before overwriting.
- If a file has the marker and correct path but the content differs from
  the new source: report the change and prompt me.
- If everything matches (path, marker, content): skip it silently or
  report as "unchanged."

Show the plan (what will be created, updated, or migrated) and wait for
my approval before writing files.
---

The agent does the actual file generation. This shim cannot directly write
host-tool files because they require host-tool context (frontmatter
conventions, command vs. skill choice) that an agent decides better than a
shell script.

Important boundary: this CLI does not execute audits. Use your host-tool
slash command flow (\`/determinagents\` or \`/determinagents <behavior>\`)
to run audits — or 'determinagents prompt' with a behavior name for a
paste-ready prompt you can hand to any coding agent with no host install.
MSG
    ;;

  prompt)
    # Dynamic prompt library: print a paste-ready prompt for any behavior,
    # extracted live from INVOCATIONS.md (the single source of truth —
    # prompt text is never copied into this shim). Works for any AI CLI:
    # pipe, paste, or backtick-embed the output.
    # `--remote` resolves INVOCATIONS.md over HTTPS (ref-pinned, cached)
    # instead of disk — for cloud agents with no local library.
    INVOC="$DETERMINAGENTS_HOME/INVOCATIONS.md"
    PROMPT_REMOTE=0; PROMPT_REF="${DETERMINAGENTS_REF:-main}"; PROMPT_FLAGS=""
    for _pf in "$@"; do
      case "$_pf" in
        --remote) PROMPT_REMOTE=1 ;;
        --ref=*) PROMPT_REF="${_pf#--ref=}" ;;
        *) PROMPT_FLAGS="$PROMPT_FLAGS $_pf" ;;
      esac
    done
    # shellcheck disable=SC2086
    set -- $PROMPT_FLAGS
    if [ "$PROMPT_REMOTE" -eq 1 ]; then
      case "$PROMPT_REF" in
        ""|*..*|*[!A-Za-z0-9._/-]*)
          echo "error: invalid --ref (allowed: A–Z a–z 0–9 . _ - /)" >&2
          exit 1
          ;;
      esac
      _repo="${DETERMINAGENTS_REPO_URL:-https://github.com/iansherr/determinagents.git}"
      if [ -n "${DETERMINAGENTS_RAW_BASE:-}" ]; then
        _raw="$DETERMINAGENTS_RAW_BASE"
      else
        _slug=$(printf '%s' "$_repo" | sed -e 's|^[^/]*//[^/]*/||' -e 's|\.git$||' -e 's|/|-|g')
        case "$_slug" in
          ""|*[!A-Za-z0-9._-]*)
            echo "error: cannot derive a raw base from DETERMINAGENTS_REPO_URL=$_repo" >&2
            exit 1
            ;;
        esac
        _raw="https://raw.githubusercontent.com/$_slug/$PROMPT_REF"
      fi
      _safe_ref=$(printf '%s' "$PROMPT_REF" | tr '/' '-')
      _cachedir="${XDG_CACHE_HOME:-$HOME/.cache}/determinagents/remote/$_safe_ref"
      mkdir -p "$_cachedir"
      if [ ! -f "$_cachedir/INVOCATIONS.md" ]; then
        if command -v curl >/dev/null 2>&1; then
          _fetch="curl -fsSL -o $_cachedir/INVOCATIONS.md $_raw/INVOCATIONS.md"
        elif command -v wget >/dev/null 2>&1; then
          _fetch="wget -q -O $_cachedir/INVOCATIONS.md $_raw/INVOCATIONS.md"
        else
          echo "error: --remote needs curl or wget" >&2
          exit 1
        fi
        # shellcheck disable=SC2086
        if ! $_fetch 2>/dev/null; then
          echo "error: could not fetch INVOCATIONS.md from $_raw" >&2
          exit 1
        fi
      fi
      DETERMINAGENTS_INVOC_FILE="$_cachedir/INVOCATIONS.md"
      export DETERMINAGENTS_INVOC_FILE
      PROMPT_RAWBASE="$_raw"
      PROMPT_PINNED=0
      if [ "${#PROMPT_REF}" -eq 40 ]; then
        case "$PROMPT_REF" in
          *[!0-9a-f]*) ;;
          *) PROMPT_PINNED=1 ;;
        esac
      fi
      if [ "$PROMPT_PINNED" -ne 1 ]; then
        echo "warning: mutable ref '$PROMPT_REF' — pin a full commit SHA via --ref= for unattended use" >&2
      fi
    elif [ ! -f "$INVOC" ]; then
      echo "error: INVOCATIONS.md not found at $INVOC" >&2
      exit 1
    fi
    # Behavior helpers (_det_tokens, _det_doc, _det_section,
    # _det_anchor_line, _det_routing) live at top level.
    sub2="${1:-}"
    shift 2>/dev/null || true
    case "$sub2" in
      ""|--help|-h)
        echo "usage: determinagents prompt <behavior> [flags]"
        echo "       determinagents prompt <behavior> --remote [--ref=<sha|branch>] [flags]"
        echo "       determinagents prompt --list"
        echo ""
        echo "print a paste-ready prompt for any behavior. hand the output"
        echo "to any coding agent — no host-tool install required."
        echo "--remote resolves the library over HTTPS (ref-pinned, cached)"
        echo "and rewrites paths to raw URLs: for cloud agents with no"
        echo "local install. default ref is \$DETERMINAGENTS_REF or 'main';"
        echo "pin a full commit SHA for unattended use."
        echo ""
        echo "behaviors:"
        _det_tokens | sed 's/^/  /'
        exit 0
        ;;
      --list|list)
        _det_tokens
        exit 0
        ;;
    esac
    token="$sub2"
    doc=$(_det_doc "$token")
    if [ -z "$doc" ] && ! grep -qE "^<!-- prompt:([a-z,-]*,)?$token(,| -->)" "$(_det_invoc)"; then
      echo "unknown behavior: $token" >&2
      echo "run 'determinagents prompt --list' for behaviors" >&2
      exit 1
    fi
    if [ "$PROMPT_REMOTE" -eq 1 ]; then
      echo "# determinagents prompt: $token $*"
      echo "# library (remote): $PROMPT_RAWBASE @ $PROMPT_REF"
      echo "# paste everything below into any coding agent. library paths"
      echo "# are raw URLs at the pinned ref above — no local install needed."
      echo ""
    else
      if [ -d "$DETERMINAGENTS_HOME/.git" ]; then
        LIB_SHA=$(git -C "$DETERMINAGENTS_HOME" rev-parse --short HEAD 2>/dev/null || echo "?")
        LIB_BRANCH=$(git -C "$DETERMINAGENTS_HOME" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
        LIB_URL=$(git -C "$DETERMINAGENTS_HOME" remote get-url origin 2>/dev/null \
          || echo "https://github.com/iansherr/determinagents.git")
      else
        LIB_SHA="?"
        LIB_BRANCH="main"
        LIB_URL="https://github.com/iansherr/determinagents.git"
      fi
      echo "# determinagents prompt: $token $*"
      echo "# library: $DETERMINAGENTS_HOME ($LIB_BRANCH @ $LIB_SHA)"
      echo "# paste everything below into any coding agent."
      echo "# if the library path above is unreachable from the agent, fetch it with:"
      echo "#   git clone --depth 1 --branch $LIB_BRANCH $LIB_URL <path>"
      echo ""
    fi
    anchor_line=$(grep -n -E "^<!-- prompt:([a-z,-]*,)?$token(,| -->)" "$(_det_invoc)" | head -1 | cut -d: -f1)
    # Remote mode rewrites library paths to raw URLs at the pinned ref,
    # so the output stands alone with no local install.
    _det_emit() {
      if [ -n "$doc" ]; then
        _det_section "$anchor_line" | sed "s/<AUDIT>/$doc/g"
      else
        _det_section "$anchor_line"
      fi
    }
    if [ -n "$anchor_line" ]; then
      if [ "$PROMPT_REMOTE" -eq 1 ]; then
        _det_emit | sed "s|\$DETERMINAGENTS_HOME|$PROMPT_RAWBASE|g"
      else
        _det_emit
      fi
      if [ "$token" = "data-flow" ]; then
        case " $* " in
          *" --target="*) ;;
          *) echo "# note: DATA_FLOW_TRACE requires --target=<flow-name>" >&2 ;;
        esac
      fi
    else
      # Token routes to a doc with no dedicated INVOCATIONS.md section yet:
      # honest pointer instead of a fabricated prompt.
      if [ "$PROMPT_REMOTE" -eq 1 ]; then
        _libref="$PROMPT_RAWBASE"
      else
        _libref=\$DETERMINAGENTS_HOME
      fi
      cat <<FALLBACK
No dedicated invocation section for '$token' yet.

Run audits/$doc.md from $_libref against this repo, per the
doc's own phases. Report to docs/reports/ per specs/FORMAT.md
(audit:/date: frontmatter, P0-P3 findings with file:line and fixes).
FALLBACK
    fi
    ;;

  setup)
    # Deterministic host-tool setup: instantiate templates and generate
    # per-behavior files live from INVOCATIONS.md. No agent needed.
    # Every md/toml/mdc file carries a `generated-by: determinagents
    # setup` marker (foreign files are never overwritten without --force);
    # --remove deletes only files setup owns (marker or install manifest).
    SETUP_TOOL="${1:-}"; shift 2>/dev/null || true
    SETUP_SCOPE="global"; SETUP_FORCE=0; SETUP_REMOVE=0; SETUP_DIR=""
    for _a in "$@"; do
      case "$_a" in
        --global) SETUP_SCOPE="global" ;;
        --project) SETUP_SCOPE="project" ;;
        --force) SETUP_FORCE=1 ;;
        --remove) SETUP_REMOVE=1 ;;
        --dir=*) SETUP_DIR="${_a#--dir=}" ;;
        *) echo "unknown setup flag: $_a" >&2; exit 1 ;;
      esac
    done
    case "$SETUP_TOOL" in
      ""|--help|-h|help)
        echo "usage: determinagents setup <tool> [--global|--project] [--dir=PATH] [--force] [--remove]"
        echo "  tools: claude | opencode | gemini | agy | cursor | all"
        echo "  default scope is --global (cursor is project-only)."
        echo "  --dir=PATH installs roots under PATH (for tests/custom layouts)."
        exit 0
        ;;
      claude|opencode|gemini|agy|cursor|all) ;;
      *) echo "unknown tool: $SETUP_TOOL" >&2; exit 1 ;;
    esac
    if [ ! -d "$DETERMINAGENTS_HOME/templates" ]; then
      echo "error: templates/ missing in $DETERMINAGENTS_HOME (re-run install)" >&2
      exit 1
    fi
    if [ -n "$SETUP_DIR" ]; then
      SETUP_GLOB="$SETUP_DIR"; SETUP_PROJ="$SETUP_DIR"
    else
      SETUP_GLOB="$HOME"; SETUP_PROJ="$(pwd)"
    fi
    _setup_emit() {
      # $1 = dest; content on stdin. Marker-checked write.
      _dest="$1"
      if [ -e "$_dest" ]; then
        if grep -qF 'generated-by: determinagents setup' "$_dest" 2>/dev/null; then
          :
        elif [ "$SETUP_FORCE" -eq 1 ]; then
          echo "  force-overwrite (foreign file): $_dest"
        else
          echo "  skip (foreign file, use --force): $_dest"
          return 0
        fi
      fi
      mkdir -p "$(dirname "$_dest")"
      cat > "$_dest"
      echo "  wrote: $_dest"
    }
    _setup_template() {
      # $1 = template file, $2 = dest
      sed "s|@LIBRARY_PATH@|$DETERMINAGENTS_HOME|g" \
        "$DETERMINAGENTS_HOME/templates/$1" | _setup_emit "$2"
    }
    _setup_remove_one() {
      # $1 = file; delete only setup-owned files (marker or library path
      # in body), prune newly-empty parents.
      if [ ! -e "$1" ]; then return 0; fi
      if grep -qF 'generated-by: determinagents setup' "$1" 2>/dev/null \
        || grep -qF "$DETERMINAGENTS_HOME" "$1" 2>/dev/null; then
        rm -f "$1"
        echo "  removed: $1"
        rmdir -p "$(dirname "$1")" 2>/dev/null || true
      else
        echo "  keep (foreign file): $1"
      fi
    }
    _setup_claude() {
      if [ "$SETUP_REMOVE" -eq 1 ]; then
        _setup_remove_one "$1/.claude/skills/determinagents/SKILL.md"
        _setup_remove_one "$1/.claude/commands/determinagents.md"
        return 0
      fi
      _setup_template skill-SKILL.md "$1/.claude/skills/determinagents/SKILL.md"
      _setup_template claude-command.md "$1/.claude/commands/determinagents.md"
    }
    _setup_opencode() {
      if [ "$SETUP_REMOVE" -eq 1 ]; then
        _setup_remove_one "$1/.opencode/commands/determinagents.md"
        return 0
      fi
      _setup_template claude-command.md "$1/.opencode/commands/determinagents.md"
    }
    _setup_cursor() {
      if [ "$SETUP_REMOVE" -eq 1 ]; then
        _setup_remove_one "$1/.cursor/rules/determinagents.mdc"
        return 0
      fi
      _setup_template cursor-rule.mdc "$1/.cursor/rules/determinagents.mdc"
    }
    _setup_gemini() {
      if [ "$SETUP_REMOVE" -eq 1 ]; then
        _setup_remove_one "$1/.gemini/commands/determinagents.toml"
        _det_routing | while IFS='|' read -r _t _d; do
          _setup_remove_one "$1/.gemini/commands/determinagents/$_t.toml"
        done
        return 0
      fi
      _setup_template gemini-hub.toml "$1/.gemini/commands/determinagents.toml"
      {
        _det_routing
        echo "maintenance|DeterminAgents maintenance commands"
      } | while IFS='|' read -r _t _d; do
        {
          echo "description = \"$_d\""
          echo "prompt = \"\"\""
          echo "<!-- generated-by: determinagents setup. Safe to overwrite on re-setup. -->"
          echo "!{determinagents prompt $_t {{args}}}"
          echo ""
          echo "Follow the emitted prompt against this repo. Conventions:"
          echo "read docs/determinagents/AUDIT_CONTEXT.md first if present;"
          echo "reports to docs/reports/; read-only by default."
          echo "\"\"\""
        } | _setup_emit "$1/.gemini/commands/determinagents/$_t.toml"
      done
    }
    _setup_agy() {
      _plugdir="$1/.gemini/antigravity-cli/plugins/determinagents"
      if [ "$SETUP_REMOVE" -eq 1 ]; then
        if [ -f "$_plugdir/.determinagents-setup" ]; then
          while IFS= read -r _rel; do
            [ -n "$_rel" ] || continue
            _setup_remove_one "$_plugdir/$_rel"
          done < "$_plugdir/.determinagents-setup"
          rm -f "$_plugdir/.determinagents-setup"
          rmdir -p "$_plugdir" 2>/dev/null || true
        else
          echo "  no install manifest; removing guardedly"
          _setup_remove_one "$_plugdir/plugin.json"
          for _af in "$_plugdir"/agents/*.json; do
            [ -e "$_af" ] || continue
            _setup_remove_one "$_af"
          done
        fi
        return 0
      fi
      sed "s|@LIBRARY_PATH@|$DETERMINAGENTS_HOME|g" \
        "$DETERMINAGENTS_HOME/templates/agy-plugin.json" \
        | _setup_emit "$_plugdir/plugin.json"
      : > "$_plugdir/.determinagents-setup"
      echo "plugin.json" >> "$_plugdir/.determinagents-setup"
      _det_routing | while IFS='|' read -r _t _d; do
        _sys="Library at $DETERMINAGENTS_HOME. Run \`determinagents prompt $_t\` in a shell and follow the emitted prompt against the target repo. Conventions: docs/determinagents/AUDIT_CONTEXT.md first if present; reports to docs/reports/; read-only by default."
        {
          printf '{\n  "name": "determinagents:%s",\n  "description": "%s",\n  "system_prompt": "%s"\n}\n' \
            "$_t" "$_d" "$_sys"
        } | _setup_emit "$_plugdir/agents/determinagents-$_t.json"
        echo "agents/determinagents-$_t.json" >> "$_plugdir/.determinagents-setup"
      done
    }
    _setup_run_tool() {
      # $1 = tool, $2 = root
      echo "$1 ($SETUP_SCOPE):"
      case "$1" in
        claude) _setup_claude "$2" ;;
        opencode) _setup_opencode "$2" ;;
        gemini) _setup_gemini "$2" ;;
        agy) _setup_agy "$2" ;;
        cursor) _setup_cursor "$2" ;;
      esac
    }
    if [ "$SETUP_TOOL" = "cursor" ] && [ "$SETUP_SCOPE" = "global" ] && [ -z "$SETUP_DIR" ]; then
      echo "error: cursor rules are project-local; re-run with --project" >&2
      exit 1
    fi
    if [ "$SETUP_TOOL" = "all" ]; then
      for _tool in claude opencode gemini agy; do
        if [ "$SETUP_SCOPE" = "global" ]; then
          _setup_run_tool "$_tool" "$SETUP_GLOB"
        else
          _setup_run_tool "$_tool" "$SETUP_PROJ"
        fi
      done
      if [ "$SETUP_SCOPE" = "project" ]; then
        _setup_run_tool cursor "$SETUP_PROJ"
      else
        echo "cursor: skipped (project-only; re-run setup cursor --project)"
      fi
    else
      if [ "$SETUP_SCOPE" = "global" ]; then
        _setup_run_tool "$SETUP_TOOL" "$SETUP_GLOB"
      else
        _setup_run_tool "$SETUP_TOOL" "$SETUP_PROJ"
      fi
    fi
    ;;

  uninstall)
    printf 'Remove %s? [y/N] ' "$DETERMINAGENTS_HOME"
    read -r REPLY
    case "$REPLY" in
      y|Y|yes|YES)
        REMOVED_HOME="$DETERMINAGENTS_HOME"
        rm -rf "$DETERMINAGENTS_HOME"
        SHIM_PATH=$(command -v determinagents 2>/dev/null || echo "${DETERMINAGENTS_BIN:-$HOME/.local/bin}/determinagents")
        cat <<UNINSTALL_MSG
removed $REMOVED_HOME

Slash commands generated by 'determinagents materialize' are NOT
removed automatically — they live inside your host tool's command
directory (e.g. ~/.agy/subagents/, ~/.claude/commands/, ~/.gemini/commands/).

To clean those up, paste this prompt into the same host tool that
originally installed them:

---
Remove every DeterminAgents slash command from this host tool.
Look in the host tool's command directory (e.g. ~/.agy/subagents/,
~/.claude/commands/, ~/.gemini/commands/, .cursor/rules/) and identify files generated by
the DeterminAgents library — typically by a header comment naming
INSTALL.md as the source, or a body that references
\$DETERMINAGENTS_HOME or 'Read .../audits/<name>.md'.
Show the list and wait for my approval before deleting anything.
Do NOT match by filename alone — user files may share naming.
---

Also remove the shim itself if no longer needed:
  rm $SHIM_PATH
UNINSTALL_MSG
        ;;
      *) echo "skipped" ;;
    esac
    ;;

  doctor)
    # Read-only health check. Exit 0 if all checks pass or only warn,
    # exit 1 if any fail. Prints one line per check.
    FAIL=0
    ok()   { printf '  ok    %s\n' "$1"; }
    warn() { printf '  warn  %s\n' "$1"; }
    fail() { printf '  fail  %s\n' "$1"; FAIL=1; }

    echo "determinagents doctor"
    echo ""
    echo "library:"

    # 1. Library directory and resolution source
    if [ -d "$DETERMINAGENTS_HOME/audits" ]; then
      ok "library found at $DETERMINAGENTS_HOME ($RESOLVED_VIA)"
    else
      fail "library missing at $DETERMINAGENTS_HOME ($RESOLVED_VIA)"
    fi

    # 2. Git status
    if [ -d "$DETERMINAGENTS_HOME/.git" ]; then
      BRANCH=$(git -C "$DETERMINAGENTS_HOME" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
      SHA=$(git -C "$DETERMINAGENTS_HOME" rev-parse --short HEAD 2>/dev/null || echo "?")
      AGE_DAYS=$(( ( $(date +%s) - $(git -C "$DETERMINAGENTS_HOME" log -1 --format=%ct 2>/dev/null || echo 0) ) / 86400 ))
      if [ "$AGE_DAYS" -gt 60 ]; then
        warn "branch $BRANCH @ $SHA — last commit ${AGE_DAYS}d ago (run 'determinagents update')"
      else
        ok "branch $BRANCH @ $SHA — ${AGE_DAYS}d old"
      fi
      if [ -n "$(git -C "$DETERMINAGENTS_HOME" status --porcelain 2>/dev/null)" ]; then
        warn "working tree has local changes (will block 'determinagents update')"
      fi
    else
      warn "library is not a git checkout (automatic updates disabled)"
    fi

    echo ""
    echo "shim:"

    # 3. Shim resolution: where did `determinagents` we ran from come from?
    RUNNING_BIN="$0"
    PATH_BIN=$(command -v determinagents 2>/dev/null || echo "")

    if [ -n "$PATH_BIN" ]; then
      ok "shim on PATH: $PATH_BIN"
      # Check if the one we are running is the one on the PATH
      if [ "$(cd "$(dirname "$RUNNING_BIN")" && pwd)/$(basename "$RUNNING_BIN")" = "$(cd "$(dirname "$PATH_BIN")" && pwd)/$(basename "$PATH_BIN")" ]; then
        : # Running the one on the PATH, good.
      else
        warn "you are running $RUNNING_BIN but $PATH_BIN is first on your PATH"
      fi
    else
      warn "shim not on PATH (you ran by absolute path)"
    fi

    # 4. Consistency check
    if [ "$RESOLVED_VIA" = "relative" ]; then
      warn "running in-place from repository ($DETERMINAGENTS_HOME)"
    elif [ "$RESOLVED_VIA" = "env" ]; then
      if [ -n "$DETERMINAGENTS_BAKED_HOME" ] && [ "$DETERMINAGENTS_HOME" != "$DETERMINAGENTS_BAKED_HOME" ]; then
        warn "\$DETERMINAGENTS_HOME ($DETERMINAGENTS_HOME) overrides baked path ($DETERMINAGENTS_BAKED_HOME)"
      else
        ok "\$DETERMINAGENTS_HOME environment variable is set"
      fi
    elif [ "$RESOLVED_VIA" = "baked" ]; then
      ok "using baked path: $DETERMINAGENTS_HOME"
    fi

    echo ""
    echo "remote:"

    # 6. Remote reachable (5s timeout via git's own machinery; degrade gracefully)
    if git -C "$DETERMINAGENTS_HOME" ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1; then
      ok "origin reachable"
      LOCAL=$(git -C "$DETERMINAGENTS_HOME" rev-parse HEAD)
      REMOTE=$(git -C "$DETERMINAGENTS_HOME" ls-remote origin "$BRANCH" 2>/dev/null | awk '{print $1}')
      if [ "$LOCAL" = "$REMOTE" ]; then
        ok "up to date with origin/$BRANCH"
      else
        warn "behind origin/$BRANCH — run 'determinagents update'"
      fi
    else
      warn "could not reach origin (offline?)"
    fi

    echo ""
    echo "completions:"

    # 7. Completion: detect parent shell and tell the user how to enable.
    #    We can't introspect the parent shell's loaded functions from a child
    #    process, so we just point them at the right command.
    PARENT_SHELL=$(basename "${SHELL:-unknown}")
    case "$PARENT_SHELL" in
      bash|zsh|fish)
        ok "shell detected: $PARENT_SHELL"
        echo "        enable: see 'determinagents completions $PARENT_SHELL'"
        ;;
      *)
        warn "shell '$PARENT_SHELL' — completions ship for bash/zsh/fish only"
        ;;
    esac

    echo ""
    echo "contracts:"

    # 8. Every audit declares a machine-greppable Mode line (specs/FORMAT.md).
    #    Meta-docs (PICK_NEXT) derive the mutating set from these lines.
    MISSING_MODE=""
    for f in "$DETERMINAGENTS_HOME"/audits/*.md; do
      [ -f "$f" ] || continue
      grep -qE '^## Mode: (Read-Only|Mutating|Orchestrator|Interactive)' "$f" \
        || MISSING_MODE="$MISSING_MODE $(basename "$f")"
    done
    if [ -z "$MISSING_MODE" ]; then
      ok "every audit declares '## Mode:'"
    else
      fail "audits missing '## Mode:' line:$MISSING_MODE"
    fi

    # 9. Project overlay section names (only when run inside a project).
    #    ALL_CAPS overlay sections must name a real audit doc, or the audit
    #    that looks for its section will never find it.
    if [ -f "docs/determinagents/AUDIT_CONTEXT.md" ]; then
      BAD_SECTIONS=$(grep -oE '^## [A-Z][A-Z_]+$' docs/determinagents/AUDIT_CONTEXT.md | sed 's/^## //' \
        | while IFS= read -r name; do
            [ -f "$DETERMINAGENTS_HOME/audits/$name.md" ] || printf ' %s' "$name"
          done)
      if [ -z "$BAD_SECTIONS" ]; then
        ok "AUDIT_CONTEXT.md section names match audit docs"
      else
        warn "AUDIT_CONTEXT.md sections with no matching audit doc:$BAD_SECTIONS"
      fi
    fi

    # 10. Report frontmatter coverage (only when run inside a project).
    #     PICK_NEXT reads audit:/date: frontmatter for staleness; legacy
    #     reports without it fall back to filename parsing.
    if [ -d "docs/reports" ]; then
      TOTAL=$(find docs/reports -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
      if [ "$TOTAL" -gt 0 ]; then
        WITH=$(grep -l '^audit: ' docs/reports/*.md 2>/dev/null | wc -l | tr -d ' ')
        if [ "$WITH" -eq "$TOTAL" ]; then
          ok "all $TOTAL reports carry audit:/date: frontmatter"
        else
          warn "$((TOTAL - WITH)) of $TOTAL reports lack 'audit:' frontmatter (legacy; PICK_NEXT falls back to filename parsing)"
        fi
      fi
    fi

    echo ""
    echo "prompts:"

    # 11. Every routable behavior resolves to a prompt anchor, so
    #     `determinagents prompt <behavior>` never 404s. Tokens whose docs
    #     have no dedicated INVOCATIONS.md section yet (adversarial,
    #     init-loops, recursive, loop-orchestrator) fall back to a
    #     read-the-doc pointer and are exempt here.
    PROMPT_FALLBACK="adversarial init-loops recursive loop-orchestrator"
    MISSING_PROMPT=""
    # shellcheck disable=SC2046
    for t in $("$0" prompt --list 2>/dev/null); do
      case " $PROMPT_FALLBACK " in
        *" $t "*) continue ;;
      esac
      grep -qE "^<!-- prompt:([a-z,-]*,)?$t(,| -->)" "$DETERMINAGENTS_HOME/INVOCATIONS.md" \
        || MISSING_PROMPT="$MISSING_PROMPT $t"
    done
    if [ -z "$MISSING_PROMPT" ]; then
      ok "every behavior has a prompt anchor"
    else
      warn "behaviors with no prompt anchor:$MISSING_PROMPT"
    fi

    echo ""
    echo "setup:"

    # 12. Report which host tools have setup-owned files (global scope).
    SETUP_FOUND=""
    for _sp in \
      "claude:$HOME/.claude/skills/determinagents/SKILL.md" \
      "claude:$HOME/.claude/commands/determinagents.md" \
      "opencode:$HOME/.opencode/commands/determinagents.md" \
      "gemini:$HOME/.gemini/commands/determinagents.toml" \
      "agy:$HOME/.gemini/antigravity-cli/plugins/determinagents/plugin.json" \
      ; do
      _sn="${_sp%%:*}"; _sf="${_sp#*:}"
      _hit=0
      if [ -f "$_sf" ] && grep -qF 'determinagents setup' "$_sf" 2>/dev/null; then
        _hit=1
      elif [ "$_sn" = "agy" ] && [ -f "$HOME/.gemini/antigravity-cli/plugins/determinagents/.determinagents-setup" ]; then
        _hit=1
      fi
      case "$SETUP_FOUND" in
        *" $_sn "*) ;;
        *) [ "$_hit" -eq 1 ] && SETUP_FOUND="$SETUP_FOUND $_sn " ;;
      esac
    done
    # shellcheck disable=SC2086
    for _sn in $SETUP_FOUND; do ok "setup installed: $_sn"; done
    if [ -z "$SETUP_FOUND" ]; then
      echo "        (no host-tool setup detected — see 'determinagents setup --help')"
    fi

    echo ""
    if [ "$FAIL" -eq 0 ]; then
      echo "all checks passed"
      exit 0
    else
      echo "one or more checks failed"
      exit 1
    fi
    ;;

  completions)
    shell="${1:-}"
    case "$shell" in
      bash)
        cat <<'BASH'
# determinagents completion for bash
# enable: eval "$(determinagents completions bash)"
#   or:   determinagents completions bash > /etc/bash_completion.d/determinagents
_determinagents_complete() {
  local cur prev subs
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  subs="version path update prompt setup materialize uninstall doctor completions help"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$subs" -- "$cur") )
  elif [ "$COMP_CWORD" -eq 2 ] && [ "$prev" = "completions" ]; then
    COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
  elif [ "$COMP_CWORD" -eq 2 ] && [ "$prev" = "prompt" ]; then
    COMPREPLY=( $(compgen -W "$(determinagents prompt --list 2>/dev/null)" -- "$cur") )
  elif [ "$COMP_CWORD" -eq 2 ] && [ "$prev" = "setup" ]; then
    COMPREPLY=( $(compgen -W "claude opencode gemini agy cursor all" -- "$cur") )
  fi
}
complete -F _determinagents_complete determinagents
BASH
        ;;
      zsh)
        cat <<'ZSH'
# determinagents completion for zsh
# enable: eval "$(determinagents completions zsh)"
#   or save to a file in $fpath named _determinagents and run `compinit`
_determinagents() {
  local -a subs shells
  subs=(
    'version:show installed version (SHA, branch, date)'
    'path:print install path'
    'update:check for updates and apply with confirmation'
    'prompt:print a paste-ready prompt for a behavior'
    'setup:install skills/commands for a host tool'
    'materialize:instructions to install slash commands for host tool'
    'uninstall:remove the library'
    'doctor:run health checks'
    'completions:print shell completion script'
    'help:show help'
  )
  shells=(bash zsh fish)
  if (( CURRENT == 2 )); then
    _describe 'subcommand' subs
  elif (( CURRENT == 3 )) && [[ ${words[2]} == completions ]]; then
    _describe 'shell' shells
  elif (( CURRENT == 3 )) && [[ ${words[2]} == prompt ]]; then
    compadd -- $(determinagents prompt --list 2>/dev/null)
  elif (( CURRENT == 3 )) && [[ ${words[2]} == setup ]]; then
    compadd -- claude opencode gemini agy cursor all
  fi
}
compdef _determinagents determinagents
ZSH
        ;;
      fish)
        cat <<'FISH'
# determinagents completion for fish
# enable: determinagents completions fish | source
#   or save to ~/.config/fish/completions/determinagents.fish
complete -c determinagents -f
complete -c determinagents -n __fish_use_subcommand -a version     -d 'show installed version'
complete -c determinagents -n __fish_use_subcommand -a path        -d 'print install path'
complete -c determinagents -n __fish_use_subcommand -a update      -d 'check for updates'
complete -c determinagents -n __fish_use_subcommand -a prompt      -d 'print a paste-ready prompt'
complete -c determinagents -n __fish_use_subcommand -a setup       -d 'install skills/commands for a host tool'
complete -c determinagents -n __fish_use_subcommand -a materialize -d 'install slash commands'
complete -c determinagents -n __fish_use_subcommand -a uninstall   -d 'remove the library'
complete -c determinagents -n __fish_use_subcommand -a doctor      -d 'run health checks'
complete -c determinagents -n __fish_use_subcommand -a completions -d 'print completion script'
complete -c determinagents -n __fish_use_subcommand -a help        -d 'show help'
complete -c determinagents -n '__fish_seen_subcommand_from completions' -a 'bash zsh fish'
complete -c determinagents -n '__fish_seen_subcommand_from prompt' -a '(determinagents prompt --list)'
complete -c determinagents -n '__fish_seen_subcommand_from setup' -a 'claude opencode gemini agy cursor all'
FISH
        ;;
      "")
        cat >&2 <<USAGE
usage: determinagents completions <shell>
  shells: bash, zsh, fish

bash:  eval "\$(determinagents completions bash)"
zsh:   eval "\$(determinagents completions zsh)"
fish:  determinagents completions fish | source
USAGE
        exit 1
        ;;
      *)
        echo "error: unknown shell '$shell' (supported: bash, zsh, fish)" >&2
        exit 1
        ;;
    esac
    ;;

  help|--help|-h|"")
    cat <<HELP
determinagents — universal, self-discovering audit prompts for coding agents

boundary:
  this CLI does not execute audits.
  run them via host-tool slash commands (/determinagents ...) or
  'determinagents prompt <behavior>' for a paste-ready prompt.

usage: determinagents <command>

  version              show installed version (SHA, branch, date)
  path                 print library path
  update               check for updates and apply with confirmation
  prompt <behavior> [flags]  print a paste-ready prompt for any behavior
                        (pipe or paste into any AI CLI — no host-tool
                        install required). 'prompt --list' shows behaviors.
  setup <tool> [--global|--project]  install skills/commands for a host
                        tool deterministically (claude|opencode|gemini|
                        agy|cursor|all). 'setup <tool> --remove' uninstalls.
  materialize          instructions to install slash commands for your host
                       tool (the agent detects Claude Code / Gemini / Cursor /
                       etc. from its own context — same prompt for all)
  uninstall            remove the library
  doctor               run health checks (library, shim, remote, completions)
  completions <shell>  print shell completion script (bash, zsh, fish)
  help                 this message

env:
  DETERMINAGENTS_HOME  library path (default: ~/.determinagents)
  DETERMINAGENTS_BIN   shim install path (default: ~/.local/bin)

docs:
  $DETERMINAGENTS_HOME/README.md         overview
  $DETERMINAGENTS_HOME/INVOCATIONS.md    paste-ready prompts
  $DETERMINAGENTS_HOME/INSTALL.md        host-tool install spec
HELP
    ;;

  *)
    echo "unknown command: $cmd" >&2
    echo "note: audits run via /determinagents in your host tool, not this CLI" >&2
    echo "run 'determinagents help' for usage" >&2
    exit 1
    ;;
esac
